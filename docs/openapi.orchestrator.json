    "/runs/{run_id}/amend": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Amend Run",
        "description": "Change the requirement of a run that is not finished. ``actor`` is mandatory and attributed.\n\nThe new text is length-limited and passes the same policy scan as artifacts. Root stages run again; only\nstages whose consumed artifacts change run again after them; pending approvals are withdrawn and asked\nagain on the new evidence. 404 unknown run, 409 finished or stopping run, 422 bad actor/text/policy.",
        "operationId": "amend_run_runs__run_id__amend_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Block until the run is terminal or waiting for approval",
              "default": false,
              "title": "Wait"
            },
            "description": "Block until the run is terminal or waiting for approval"
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 600,
              "minimum": 0,
              "description": "Max seconds to block when wait=true",
              "default": 30.0,
              "title": "Timeout"
            },
            "description": "Max seconds to block when wait=true"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AmendRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Amendment accepted; the run re-plans in the background",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AmendAccepted"
                }
              }
            }
          },
          "200": {
            "description": "With wait=true: the run once settled (or on timeout)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run, approval or scenario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "State conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
