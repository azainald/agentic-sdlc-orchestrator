          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Block until the run is terminal or waiting for approval",
              "default": false,
              "title": "Wait"
            },
            "description": "Block until the run is terminal or waiting for approval"
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 600,
              "minimum": 0,
              "description": "Max seconds to block when wait=true",
              "default": 30.0,
              "title": "Timeout"
            },
            "description": "Max seconds to block when wait=true"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecision"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Decision accepted; the run resumes in the background",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalAccepted"
                }
              }
            }
          },
          "200": {
            "description": "With wait=true: the run once settled (or on timeout)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run, approval or scenario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
