            "title": "Kind"
          },
          "status": {
            "$ref": "#/components/schemas/ApprovalStatus",
            "default": "pending"
          },
          "requested_at": {
            "type": "number",
            "title": "Requested At"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "run_id",
          "stage_id",
          "kind"
        ],
        "title": "Approval"
      },
      "ApprovalAccepted": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "decision": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "links": {
            "additionalProperties": {
