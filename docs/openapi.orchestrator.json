    "/runs/{run_id}/trace": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Trace",
        "description": "Audit events (telemetry) plus the decision lineage stored on the run.\n\nHonesty note: ``events`` comes from the telemetry's in-memory buffer (bounded, lost on restart; the JSONL\naudit file is the durable copy of it). ``decisions`` is persisted with the run and always complete.",
        "operationId": "get_trace_runs__run_id__trace_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
