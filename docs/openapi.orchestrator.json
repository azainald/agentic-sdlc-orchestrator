          },
          "actor": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "requirement",
          "actor"
        ],
        "title": "AmendRequest",
        "description": "A named human changes the requirement of a run that is not finished (see docs/REPLAN.md)."
      },
      "Approval": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "stage_id": {
