          }
        },
        "type": "object",
        "required": [
          "run_id",
          "actor",
          "previous_requirement_sha256",
          "requirement_sha256",
          "links"
        ],
        "title": "AmendAccepted"
      },
      "AmendRequest": {
        "properties": {
