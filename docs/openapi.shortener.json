{
  "openapi": "3.1.0",
  "info": {
    "title": "URL Shortener",
    "description": "Create short links, redirect, expire them and see click analytics.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/urls": {
      "post": {
        "tags": [
          "urls"
        ],
        "summary": "Create Url",
        "description": "Create a short link. Retrying with the same Idempotency-Key and body is safe.",
        "operationId": "create_url_api_v1_urls_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUrlRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlResponse"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of an earlier request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlResponse"
                }
              }
            }
          },
          "409": {
            "description": "Alias taken or Idempotency-Key reused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid url, alias or ttl_seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/urls/{code}": {
      "get": {
        "tags": [
          "urls"
        ],
        "summary": "Get Url",
        "operationId": "get_url_api_v1_urls__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlMetadataResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Link deleted or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "urls"
        ],
        "summary": "Update Url",
        "description": "Change the destination and/or lifetime. ttl_seconds counts from now.",
        "operationId": "update_url_api_v1_urls__code__patch",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlMetadataResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Link deleted or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid update",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "urls"
        ],
        "summary": "Delete Url",
        "operationId": "delete_url_api_v1_urls__code__delete",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Link deleted or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/urls/{code}/analytics": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Get Analytics",
        "operationId": "get_analytics_api_v1_urls__code__analytics_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Link deleted or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/{code}": {
      "get": {
        "tags": [
          "redirect"
        ],
        "summary": "Redirect",
        "operationId": "redirect__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "referer",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Referer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the destination"
          },
          "404": {
            "description": "Unknown code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Link deleted or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyticsResponse": {
        "properties": {
          "total_clicks": {
            "type": "integer",
            "title": "Total Clicks"
          },
          "clicks_by_day": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Clicks By Day",
            "description": "UTC day (YYYY-MM-DD) -> clicks."
          },
          "top_referrers": {
            "items": {
              "$ref": "#/components/schemas/ReferrerCount"
            },
            "type": "array",
            "title": "Top Referrers"
          },
          "unique_visitors": {
            "type": "integer",
            "title": "Unique Visitors",
            "description": "Distinct hashed client IPs."
          }
        },
        "type": "object",
        "required": [
          "total_clicks",
          "clicks_by_day",
          "top_referrers",
          "unique_visitors"
        ],
        "title": "AnalyticsResponse"
      },
      "CreateUrlRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Destination http(s) URL.",
            "examples": [
              "https://example.com/page"
            ]
          },
          "alias": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alias",
            "description": "Optional custom short code (3-32 chars: A-Z a-z 0-9 _ -)."
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 31536000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds",
            "description": "Optional lifetime in seconds; the link expires afterwards."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateUrlRequest"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "ReferrerCount": {
        "properties": {
          "referrer": {
            "type": "string",
            "title": "Referrer"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "referrer",
          "count"
        ],
        "title": "ReferrerCount"
      },
      "UpdateUrlRequest": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "New destination URL."
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 31536000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds",
            "description": "New lifetime counted from now; null means 'never expires'."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UpdateUrlRequest",
        "description": "Send only the fields to change. ttl_seconds=null removes the expiry."
      },
      "UrlMetadataResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "short_url": {
            "type": "string",
            "title": "Short Url"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "UTC ISO-8601 time, or null if it never expires."
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'active' or 'expired' (deleted links answer 410)."
          }
        },
        "type": "object",
        "required": [
          "code",
          "short_url",
          "url",
          "expires_at",
          "created_at",
          "status"
        ],
        "title": "UrlMetadataResponse"
      },
      "UrlResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "short_url": {
            "type": "string",
            "title": "Short Url"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "UTC ISO-8601 time, or null if it never expires."
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "code",
          "short_url",
          "url",
          "expires_at",
          "created_at"
        ],
        "title": "UrlResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
